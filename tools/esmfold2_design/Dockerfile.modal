# ESMFold2 design (MIT, EvolutionaryScale 2025) — gradient inversion of
# ESMFold2 for de novo minibinders and framework-locked scFv CDR design.
#
# Strategy: pytorch base for CUDA + cuDNN pins, then layer in the conda-only
# deps (anarci / hmmer) via micromamba in a non-base env, then pip install
# esm and clone the cookbook tutorial that defines ESMFold2Design.
#
# The cookbook's binder_design.py is NOT shipped as part of the esm pip
# package — it lives under cookbook/tutorials/. We clone the upstream
# repo at a pinned SHA and copy that one file into /opt/. The pin keeps
# deploys reproducible; bumping the SHA is a one-line edit.
#
# Weights (~30 GB ESMFold2 + ~5 GB ESMC) are mounted via Modal Volume
# at /models so the first cold deploy pays the HF download once and
# every subsequent invocation finds them cached.

FROM pytorch/pytorch:2.4.0-cuda12.1-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    HF_HOME=/models \
    HF_XET_HIGH_PERFORMANCE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        git build-essential ca-certificates curl wget \
    && rm -rf /var/lib/apt/lists/*

# Micromamba in a side env for the conda-only deps (anarci + hmmer).
# We install into a named env then export its bin/ onto PATH so the pip
# install of esm in the base env can still resolve hmmer at runtime.
RUN curl -L https://micro.mamba.pm/api/micromamba/linux-64/latest \
        | tar -xvj -C /usr/local bin/micromamba \
    && test -x /usr/local/bin/micromamba \
    && /usr/local/bin/micromamba shell init -s bash -p /opt/micromamba \
    && /usr/local/bin/micromamba create -y -p /opt/micromamba/envs/anarci \
        -c conda-forge -c bioconda \
        python=3.12 'anarci>=2020.04.03' 'hmmer=3.4' \
    && /usr/local/bin/micromamba clean -afy

ENV PATH=/opt/micromamba/envs/anarci/bin:${PATH}

# esm package + abnumber. esm is pinned to the same SHA the cookbook
# was published against. Bump the SHA to bump the model + algorithm.
ARG ESM_GIT_SHA=f652b471d29d
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir abnumber requests pandas py3Dmol \
    && pip install --no-cache-dir "esm @ git+https://github.com/evolutionaryscale/esm.git@${ESM_GIT_SHA}"

# Clone the cookbook tutorial at the same SHA and copy binder_design.py
# into /opt/. The Modal app puts /opt/ on sys.path so run_pipeline.py
# can ``import binder_design`` directly.
RUN git clone --depth 1 https://github.com/evolutionaryscale/esm.git /tmp/esm-repo \
    && cd /tmp/esm-repo && git fetch --depth 1 origin ${ESM_GIT_SHA} && git checkout ${ESM_GIT_SHA} \
    && cp /tmp/esm-repo/cookbook/tutorials/binder_design.py /opt/binder_design.py \
    && rm -rf /tmp/esm-repo

WORKDIR /opt
