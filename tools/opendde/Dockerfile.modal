# OpenDDE (Apache-2.0, Aureka AI Research) — all-atom co-folding foundation model.
#
# Strategy: base on the OFFICIAL, version-pinned OpenDDE image. It bundles the
# exact opendde package, CUDA 12.6, cuDNN, and a Python in opendde's supported
# range (3.11-3.13) — a single reproducible artifact, which is the cleanest pin
# now that the verified install is PyPI (`uv pip install "opendde[gpu]"`), NOT a
# git+SHA VCS pin. We add only the two host-side deps the pipeline needs on top:
# gemmi (best-effort mmCIF->PDB for the viewer) and requests (presigned uploads).
#
# PIN: by DIGEST, not by tag. `:v1` is the preview release (2026-07-03) and is
# the repo's ONLY tag, so an upstream retag would silently move every rebuild
# with nothing in this repo changing — the same class of break that took out
# every proteina design run when a transitive dep moved under an unpinned build.
# The digest below is what `:v1` resolved to on 2026-08-17. Nothing in this repo
# records which digest earlier deploys used, so treating this as the same content
# is an inference, not a record — though the config blob's 2026-07-02 creation
# date predates them all. To bump: re-verify the `opendde pred` argparse against
# the new image, then
#   docker buildx imagetools inspect aurekaresearch/opendde:v1
# and paste the new digest here in the same commit. The HF CHECKPOINT revision is
# pinned separately in tools/opendde/seed_volumes.py.
#
# ALT (if Modal cannot use this image's Python with add_python=None): base on
#   nvidia/cuda:12.6.2-cudnn-runtime-ubuntu24.04, `apt-get install python3.12`,
#   then `pip install uv && uv pip install --system --torch-backend cu126
#   "opendde[gpu]==<ver>" gemmi requests huggingface_hub`.
FROM aurekaresearch/opendde:v1@sha256:a9404f76df1cd965a80447ee30c9c440af48b199581d9bd44ee157c18109a9d6

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    OPENDDE_ROOT_DIR=/opt/opendde_root

# NOTE: do NOT pre-create /opt/opendde_root. The opendde-weights Volume mounts
# there at runtime and Modal creates the mount point itself; pre-creating it (even
# an empty checkpoint/ subdir) makes the path non-empty and the Volume mount fails
# at run time with "cannot mount volume on non-empty path" — a failure the deploy
# never surfaces (deploy only builds), so it would strike the first paying job.
# (Found at the O-1 canary.)

# The base image installs OpenDDE (via uv) into the SYSTEM python /usr/bin/python3
# (3.12): that interpreter HAS opendde but NO pip, and requests/gemmi are absent
# (so a plain `pip install` / `python3 -m pip` fails). The `opendde` console
# script's shebang is #!/usr/bin/python and `python3` already resolves to
# /usr/bin/python3, so run_pipeline.py (spawned as `python3` by modal_app.py) runs
# on the SAME interpreter as opendde — no symlink needed. Add our two host-side
# deps (gemmi for mmCIF->PDB, requests for presigned uploads) into it with uv. The
# fallback chain covers uv's system / PEP-668 externally-managed modes.
RUN /root/.local/bin/uv pip install --python /usr/bin/python3 --no-cache gemmi requests \
    || /root/.local/bin/uv pip install --python /usr/bin/python3 --system --no-cache gemmi requests \
    || /root/.local/bin/uv pip install --python /usr/bin/python3 --system --break-system-packages --no-cache gemmi requests

# Self-verifying build gates (HARD-fail, loud+safe, so drift surfaces at build
# rather than on a paying run):
#  1. the runtime interpreter run_pipeline.py uses can import opendde + both deps;
#  2. the `opendde pred` CLI still matches the verified interface.
RUN python3 -c "import sys, opendde, requests, gemmi; print('opendde+deps OK on', sys.executable)"
RUN opendde --help >/dev/null 2>&1 && opendde pred --help >/dev/null 2>&1

WORKDIR /opt
